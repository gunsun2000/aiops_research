{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Orchestrator: Install",
      "type": "shell",
      "command": "python -m pip install -e \".[dev,ui,ml]\"",
      "problemMatcher": []
    },
    {
      "label": "Orchestrator: Test",
      "type": "shell",
      "command": "python -m pytest",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Orchestrator: Start API",
      "type": "shell",
      "command": "python -m orchestrator_agent.web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "orchestrator-agent",
        "pattern": { "regexp": ".*" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Uvicorn running on"
        }
      }
    }
  ]
}
