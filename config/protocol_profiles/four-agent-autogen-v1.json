{
  "profile_id": "four-agent-autogen-v1",
  "version": "1.0.0",
  "agents": [
    {
      "name": "AIServiceHASupportAgent",
      "implementation_id": "autogen-round-robin-ha",
      "runtime": "autogen-round-robin",
      "enabled": true,
      "veto_scopes": ["availability", "recovery"],
      "consensus_weight": 1.0,
      "capabilities": ["diagnose", "review", "post_review"]
    },
    {
      "name": "AIApplicationManagementAgent",
      "implementation_id": "autogen-round-robin",
      "runtime": "autogen-round-robin",
      "enabled": true,
      "veto_scopes": ["action_validity", "target_alignment"],
      "consensus_weight": 1.0,
      "capabilities": ["propose", "review", "post_review"]
    },
    {
      "name": "AISemiconductorInfraOpsAgent",
      "implementation_id": "autogen-round-robin-infrastructure",
      "runtime": "autogen-round-robin",
      "enabled": true,
      "veto_scopes": ["capacity", "resource_safety"],
      "consensus_weight": 1.0,
      "capabilities": ["review", "post_review"]
    },
    {
      "name": "CostOptimizationAgent",
      "implementation_id": "autogen-round-robin-cost",
      "runtime": "autogen-round-robin",
      "enabled": true,
      "veto_scopes": ["budget", "cost_efficiency"],
      "consensus_weight": 1.0,
      "capabilities": ["review", "post_review"]
    }
  ],
  "review_matrix": {
    "AIServiceHASupportAgent": [
      "AIApplicationManagementAgent",
      "AISemiconductorInfraOpsAgent"
    ],
    "AIApplicationManagementAgent": [
      "AIServiceHASupportAgent",
      "AISemiconductorInfraOpsAgent",
      "CostOptimizationAgent"
    ],
    "AISemiconductorInfraOpsAgent": [
      "AIApplicationManagementAgent",
      "CostOptimizationAgent"
    ],
    "CostOptimizationAgent": [
      "AIApplicationManagementAgent",
      "AISemiconductorInfraOpsAgent"
    ]
  },
  "consensus_strategy": "role_based_veto",
  "max_negotiation_rounds": 2,
  "max_replan_attempts": 1,
  "fallback_action": "observe_only",
  "human_review_on_failure": true,
  "action_space": ["observe_only", "rollout_restart", "scale_out"],
  "reward_weights": {
    "availability_recovery": 0.4,
    "action_validity": 0.3,
    "resource_safety": 0.2,
    "cost_efficiency": 0.1
  },
  "experiment_tags": [
    "autogen",
    "runtime-support",
    "role-based-veto"
  ]
}
