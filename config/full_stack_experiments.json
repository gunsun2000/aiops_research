{
  "environment": {
    "name": "full-stack",
    "components": [
      "kube-prometheus-stack",
      "online-boutique-full",
      "chaos-mesh",
      "4-agent-runner",
      "result-archive"
    ]
  },
  "scenarios": [
    {
      "id": "cpu-stress",
      "fault": "Chaos Mesh StressChaos CPU load on paymentservice",
      "metric": "cpu",
      "query": "sum(rate(container_cpu_usage_seconds_total{namespace=\"online-boutique\",pod=~\"paymentservice-.*\",container!=\"\",image!=\"\"}[2m])) * 100",
      "threshold": 0.5,
      "service": "paymentservice",
      "chaos_manifest": "k8s/chaos/paymentservice-cpu-stress.yaml"
    },
    {
      "id": "memory-stress",
      "fault": "Chaos Mesh StressChaos memory load on checkoutservice",
      "metric": "restart_count",
      "query": "max(increase(kube_pod_container_status_restarts_total{namespace=\"online-boutique\",pod=~\"checkoutservice-.*\",container!=\"POD\"}[5m]))",
      "threshold": 0.5,
      "service": "checkoutservice",
      "chaos_manifest": "k8s/chaos/checkoutservice-memory-stress.yaml"
    },
    {
      "id": "pod-kill",
      "fault": "Chaos Mesh PodChaos pod kill on paymentservice",
      "metric": "availability",
      "query": "max(kube_deployment_status_replicas_available{namespace=\"online-boutique\",deployment=\"paymentservice\"})",
      "threshold": 2,
      "service": "paymentservice",
      "chaos_manifest": "k8s/paymentservice-pod-kill.yaml"
    },
    {
      "id": "network-delay",
      "fault": "Chaos Mesh NetworkChaos latency on paymentservice",
      "metric": "latency",
      "query": "up",
      "threshold": 0.5,
      "service": "paymentservice",
      "chaos_manifest": "k8s/chaos/paymentservice-network-delay.yaml"
    }
  ],
  "variations": [
    {
      "id": "fault-type-comparison",
      "variable": "fault_type",
      "description": "Compare pod kill, network delay, CPU stress, and memory stress while keeping the full-stack environment fixed."
    },
    {
      "id": "agent-policy-comparison",
      "variable": "agent_policy",
      "description": "Compare the full 4-agent policy with ablations such as without cost review or without infrastructure review."
    },
    {
      "id": "llm-model-comparison",
      "variable": "llm_model",
      "description": "Compare deterministic policy, gpt-5.5 AutoGen, lower-cost fallback models, and later model upgrades with the same scenario."
    },
    {
      "id": "reward-sensitivity",
      "variable": "reward_policy",
      "description": "Change reward weights while keeping the action validator and scenario fixed."
    },
    {
      "id": "baseline-comparison",
      "variable": "baseline",
      "description": "Compare 4-agent control against single-agent and no-agent kubectl/manual baselines."
    }
  ]
}
